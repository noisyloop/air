# Copy to .env for local development. Compose reads this file automatically.

# --- Postgres ---
POSTGRES_USER=air
POSTGRES_PASSWORD=air_dev_password
POSTGRES_DB=air
DATABASE_URL=postgresql://air:air_dev_password@localhost:5432/air?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=air-minio
S3_SECRET_KEY=air_minio_secret
S3_BUCKET_AUDIO=air-audio
S3_BUCKET_ART=air-art
S3_BUCKET_UPLOADS=air-uploads
# Public base URL the browser can reach for artwork (MinIO in dev)
S3_PUBLIC_URL=http://localhost:9000

# --- Meilisearch ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=air_meili_master_key

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
# Origin allowed by CORS + used in absolute links
WEB_ORIGIN=http://localhost:5173
# Secrets: generate with `openssl rand -hex 32`
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Secure cookies require HTTPS; keep false in local dev
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
# Signed stream/download URL lifetime (seconds)
SIGNED_URL_TTL=900
RATE_LIMIT_MAX=300
LOG_LEVEL=info

# --- Frontend ---
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
